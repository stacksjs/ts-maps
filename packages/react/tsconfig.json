{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "isolatedDeclarations": false,
    "paths": {
      "ts-maps": [
        "../ts-maps/src"
      ],
      "ts-maps/*": [
        "../ts-maps/src/*"
      ]
    },
    "types": [
      "bun"
    ]
  },
  "include": [
    "src/**/*",
    "test/**/*"
  ],
  "exclude": [
    "dist",
    "node_modules"
  ]
}
