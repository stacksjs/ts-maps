<script server>
/**
 * Search, after Apple Maps: "Search Maps" with Find Nearby and Recents,
 * suggestions as you type, pins for results, and a card with Directions.
 *
 * ```stx
 * <Map center="[37.79, -122.41]" zoom="15">
 *   <TurnByTurn />
 *   <Search query="coffee" />
 * </Map>
 * ```
 *
 * `query` searches straight away. With a `<TurnByTurn>` in the same map,
 * Directions on a place's card previews the route on it. Every prop is
 * followed after mount: a changed `data-options` goes to the control's
 * `sync`. Events cannot be props here — stx passes props as data — so each
 * one is a DOM event bubbling from the map: `search:results`,
 * `search:select`, `search:details` (a chosen place's hours, phone and
 * website, `{ place, details }`), `search:directions`, `search:save` and
 * `search:unsave` (Save on a place's card, `{ place }`) and `search:clear`,
 * with the core event as `detail`. `:showSaved="false"` leaves Favorites'
 * stars off the map. `search:ready` hands the page the control itself, for
 * `search`, `select` and `sync` later — and for the live options markup
 * cannot carry, `provider`, `offline`, `location`, `origin`, `details`,
 * `shareUrl` and `saved` (where Save keeps Favorites; default the page's
 * `savedPlaces()`):
 *
 * ```js
 * container.addEventListener('search:ready', e => { search = e.detail.control })
 * useMine.onclick = () => search.sync({ provider: myGeocoder })
 * ```
 */
export const optionsJson = JSON.stringify({
  query: $props.query,
  position: $props.position,
  placeholder: $props.placeholder,
  categories: $props.categories,
  recents: $props.recents,
  units: $props.units,
  language: $props.language,
  showSaved: $props.showSaved,
})
</script>

<span
  hidden
  data-ts-map-child="search"
  data-options="{{ optionsJson }}"
></span>
